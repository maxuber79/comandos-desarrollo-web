      "color": "#0070f2",
      "description": "Herramientas para desarrollo Fiori en SAP Business Application Studio.",
      "link": "https://help.sap.com/docs/SAP_FIORI_tools",
      "commands": [
        { "label": "Iniciar sesión Cloud Foundry", "cmd": "cf login -a https://api.cf.<region>.hana.ondemand.com" },
        { "label": "Listar orgs y spaces", "cmd": "cf orgs && cf spaces" },
        { "label": "Seleccionar org y space", "cmd": "cf target -o MI-ORG -s MI-SPACE" },
        { "label": "Listar apps desplegadas", "cmd": "cf apps" },
        { "label": "Desplegar app a CF", "cmd": "cf push NOMBRE-APP" },
        { "label": "Ver logs de app", "cmd": "cf logs NOMBRE-APP" },
        { "label": "Ver eventos recientes", "cmd": "cf events NOMBRE-APP" },
        { "label": "Detener app", "cmd": "cf stop NOMBRE-APP" },
        { "label": "Iniciar app detenida", "cmd": "cf start NOMBRE-APP" },
        { "label": "Reiniciar app", "cmd": "cf restart NOMBRE-APP" },
        { "label": "Listar servicios disponibles", "cmd": "cf marketplace" },
        { "label": "Crear instancia de servicio", "cmd": "cf create-service SERVICE PLAN MI-INSTANCIA" },
        { "label": "Bindear servicio a app", "cmd": "cf bind-service NOMBRE-APP MI-INSTANCIA" },
        { "label": "Listar servicios creados", "cmd": "cf services" },
        { "label": "Crear app Fiori desde plantilla", "cmd": "fiori create --project-name mi-fiori-app --template Fiori_elements" },
        { "label": "Añadir funcionalidad a Fiori", "cmd": "fiori add" },
        { "label": "Servir app Fiori local", "cmd": "npm run start" },
        { "label": "Build de app Fiori", "cmd": "npm run build" },
        { "label": "Construir MTA", "cmd": "mbt build -t ./ --mtar mi-app_1.0.0.mtar" },
        { "label": "Desplegar MTA a CF", "cmd": "cf deploy mi-app_1.0.0.mtar" },
        { "label": "Inicializar proyecto CAP", "cmd": "cds init mi-cap-project" },
        { "label": "Watch CAP (desarrollo)", "cmd": "cds watch" },
        { "label": "Build CAP", "cmd": "cds build --production" },
        { "label": "Desplegar CAP a CF", "cmd": "cds deploy --to hana" }
      ]
    },
    {
      "id": "extras",
      "title": "Extras & Carpetas",
      "icon": "bi bi-folder-plus",
      "color": "#f8f8f2",
      "description": "Comandos útiles para crear estructura de carpetas y archivos.",
      "link": "#",
      "commands": [
        { "label": "Crear carpeta (Bash)", "cmd": "mkdir src/app/components/header" },
        { "label": "Crear varias carpetas", "cmd": "mkdir docs src tests" },
        { "label": "Crear carpetas anidadas", "cmd": "mkdir -p docs/versiones" },
        { "label": "Crear archivo vacío (Bash)", "cmd": "touch archivo.txt" },
        { "label": "Crear múltiples archivos", "cmd": "touch index.html styles.css app.ts" },
        { "label": "Estructura completa de una vez", "cmd": "mkdir -p repo/docs repo/webapp && touch repo/README.md" },
        { "label": "Crear carpeta (PowerShell)", "cmd": "New-Item -ItemType Directory -Path docs" },
        { "label": "Varias carpetas (PowerShell)", "cmd": "New-Item -ItemType Directory -Path docs, src, tests" },
        { "label": "Carpetas anidadas (PowerShell)", "cmd": "New-Item -ItemType Directory -Path docs\\versiones -Force" },
        { "label": "Crear archivo (PowerShell)", "cmd": "New-Item -ItemType File -Path README.md" }
      ]
    }
  ]
}
