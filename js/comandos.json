{
  "meta": {
    "title": "Comandos de Desarrollo Web",
    "subtitle": "Cheatsheet interactivo para Git, NPM, NVM, Angular, NestJS, Firebase, Vite y SAP Fiori.",
    "author": "WEBMAIN"
  },
  "categories": [
    {
      "id": "git",
      "title": "Git",
      "icon": "devicon-git-plain",
      "color": "#f15b2c",
      "description": "Sistema de control de versiones distribuido.",
      "link": "https://git-scm.com/",
      "commands": [
        { "label": "Configurar nombre global", "cmd": "git config --global user.name \"John Doe\"" },
        { "label": "Configurar email global", "cmd": "git config --global user.email johndoe@example.com" },
        { "label": "Ver versión", "cmd": "git --version" },
        { "label": "Versión corta", "cmd": "git -v" },
        { "label": "Actualizar Git en Windows", "cmd": "git update-git-for-windows" },
        { "label": "Inicializar repositorio", "cmd": "git init" },
        { "label": "Clonar repositorio", "cmd": "git clone https://github.com/USER/REPO.git" },
        { "label": "Clonar en carpeta específica", "cmd": "git clone https://github.com/USER/REPO.git mi-carpeta" },
        { "label": "Añadir todo al stage", "cmd": "git add ." },
        { "label": "Añadir archivo específico", "cmd": "git add archivo.ts" },
        { "label": "Quitar todo del stage", "cmd": "git reset ." },
        { "label": "Quitar archivo del stage", "cmd": "git restore --staged archivo.ts" },
        { "label": "Crear commit", "cmd": "git commit -m \"primer commit\"" },
        { "label": "Stage + commit en un paso", "cmd": "git commit -am \"mensaje\"" },
        { "label": "Editar último commit", "cmd": "git commit --amend" },
        { "label": "Ver historial de commits", "cmd": "git log --oneline --graph --all" },
        { "label": "Ver cambios sin staging", "cmd": "git diff" },
        { "label": "Revertir cambios sin commit", "cmd": "git checkout -- ." },
        { "label": "Revertir un commit específico", "cmd": "git revert <commit-hash>" },
        { "label": "Guardar cambios temporales", "cmd": "git stash" },
        { "label": "Guardar cambios con mensaje", "cmd": "git stash push -m \"WIP: nombre\"" },
        { "label": "Recuperar último stash", "cmd": "git stash pop" },
        { "label": "Listar stashes", "cmd": "git stash list" },
        { "label": "Agregar remoto", "cmd": "git remote add origin https://github.com/USER/REPO.git" },
        { "label": "Renombrar remoto", "cmd": "git remote rename origin destination" },
        { "label": "Eliminar remoto", "cmd": "git remote rm destination" },
        { "label": "Ver remotos", "cmd": "git remote -v" },
        { "label": "Traer cambios del remoto", "cmd": "git pull origin main" },
        { "label": "Traer referencias sin merge", "cmd": "git fetch origin" },
        { "label": "Push al remoto", "cmd": "git push origin main" },
        { "label": "Push forzado (⚠️ con cuidado)", "cmd": "git push --force origin main" },
        { "label": "Rebase interactivo", "cmd": "git rebase -i HEAD~3" },
        { "label": "Cherry-pick (traer commit específico)", "cmd": "git cherry-pick <commit-hash>" },
        { "label": "Cambiar nombre rama default", "cmd": "git branch -m master main" },
        { "label": "Crear nueva rama", "cmd": "git branch nombre-rama" },
        { "label": "Crear y moverse a nueva rama", "cmd": "git checkout -b nombre-rama" },
        { "label": "Renombrar rama actual", "cmd": "git branch -m nuevo-nombre" },
        { "label": "Renombrar rama (estando en otra)", "cmd": "git branch -m antigua nueva" },
        { "label": "Listar ramas", "cmd": "git branch" },
        { "label": "Ver estado actual", "cmd": "git status" },
        { "label": "Moverse a una rama", "cmd": "git checkout nombre-rama" },
        { "label": "Diferencias entre ramas", "cmd": "git diff nombre-rama main" },
        { "label": "Fusionar rama", "cmd": "git merge nombre-rama" },
        { "label": "Borrar rama local", "cmd": "git branch -d nombre-rama" },
        { "label": "Forzar borrado de rama local", "cmd": "git branch -D nombre-rama" },
        { "label": "Borrar rama remota", "cmd": "git push origin --delete nombre-rama" },
        { "label": "Crear tag (release)", "cmd": "git tag -a v1.0.0 -m \"Release inicial\"" },
        { "label": "Subir tags", "cmd": "git push --tags" },
        { "label": "Generar clave SSH", "cmd": "ssh-keygen -t ed25519 -C \"email@ejemplo.com\"" },
        { "label": "Ver clave pública SSH", "cmd": "cat ~/.ssh/id_ed25519.pub" },
        { "label": "Eliminar archivo de Git", "cmd": "git rm archivo.txt" },
        { "label": "Reset suave (deshacer commit, mantén cambios)", "cmd": "git reset --soft HEAD~1" },
        { "label": "Reset duro (⚠️ descarta todo)", "cmd": "git reset --hard HEAD~1" }
      ]
    },
    {
      "id": "node",
      "title": "Node.js & NPM",
      "icon": "devicon-nodejs-plain",
      "color": "#a6e22e",
      "description": "Runtime de JS y gestor de paquetes.",
      "link": "https://nodejs.org/",
      "commands": [
        { "label": "Versión de Node", "cmd": "node --version" },
        { "label": "Versión corta Node", "cmd": "node -v" },
        { "label": "Versión de NPM", "cmd": "npm --version" },
        { "label": "Versión corta NPM", "cmd": "npm -v" },
        { "label": "Iniciar package.json", "cmd": "npm init -y" },
        { "label": "Instalar paquete", "cmd": "npm install nombre-paquete" },
        { "label": "Instalar como devDependency", "cmd": "npm install -D nombre-paquete" },
        { "label": "Instalar global", "cmd": "npm install -g nombre-paquete" },
        { "label": "Desinstalar paquete", "cmd": "npm uninstall nombre-paquete" },
        { "label": "Ejecutar script del package.json", "cmd": "npm run dev" },
        { "label": "Ejecutar paquete sin instalar", "cmd": "npx create-react-app mi-app" },
        { "label": "Actualizar NPM global", "cmd": "npm install -g npm@latest" },
        { "label": "Ver paquetes desactualizados", "cmd": "npm outdated" },
        { "label": "Auditar vulnerabilidades", "cmd": "npm audit" },
        { "label": "Corregir vulnerabilidades auto", "cmd": "npm audit fix" },
        { "label": "Instalación limpia (CI)", "cmd": "npm ci" },
        { "label": "Reinstalar dependencias", "cmd": "npm i" },
        { "label": "Eliminar node_modules", "cmd": "rm -rf node_modules" },
        { "label": "Eliminar node_modules (PowerShell)", "cmd": "Remove-Item -Recurse -Force node_modules" },
        { "label": "Limpiar caché NPM", "cmd": "npm cache clean --force" }
      ]
    },
    {
      "id": "nvm",
      "title": "NVM",
      "icon": "devicon-nodejs-plain-wordmark",
      "color": "#66d9ef",
      "description": "Node Version Manager — gestiona múltiples versiones de Node.js.",
      "link": "https://github.com/coreybutler/nvm-windows",
      "commands": [
        { "label": "Instalar versión LTS", "cmd": "nvm install --lts" },
        { "label": "Instalar versión específica", "cmd": "nvm install 20.11.0" },
        { "label": "Usar versión específica", "cmd": "nvm use 20.11.0" },
        { "label": "Ver versiones instaladas", "cmd": "nvm ls" },
        { "label": "Ver versión activa actual", "cmd": "nvm current" },
        { "label": "Establecer versión por defecto", "cmd": "nvm alias default 20.11.0" },
        { "label": "Desinstalar versión", "cmd": "nvm uninstall 18.14.0" },
        { "label": "Listar versiones disponibles", "cmd": "nvm list available" }
      ]
    },
    {
      "id": "typescript",
      "title": "TypeScript",
      "icon": "devicon-typescript-plain",
      "color": "#66d9ef",
      "description": "Superset tipado de JavaScript.",
      "link": "https://www.typescriptlang.org/",
      "commands": [
        { "label": "Instalar TypeScript global", "cmd": "npm install -g typescript" },
        { "label": "Ver versión", "cmd": "tsc --version" },
        { "label": "Versión corta", "cmd": "tsc -v" },
        { "label": "Actualizar TypeScript global", "cmd": "npm update -g typescript@latest" },
        { "label": "Crear tsconfig.json", "cmd": "tsc --init" },
        { "label": "Modo observador", "cmd": "tsc -w" },
        { "label": "Modo observador (largo)", "cmd": "tsc --watch" },
        { "label": "Compilar archivo específico", "cmd": "tsc archivo.ts" }
      ]
    },
    {
      "id": "angular",
      "title": "Angular CLI",
      "icon": "devicon-angularjs-plain",
      "color": "#fd971f",
      "description": "Framework para aplicaciones web SPA.",
      "link": "https://angular.io/",
      "commands": [
        { "label": "Instalar Angular CLI global", "cmd": "npm install -g @angular/cli" },
        { "label": "Ver versión Angular", "cmd": "ng version" },
        { "label": "Versión corta", "cmd": "ng v" },
        { "label": "Actualizar Angular CLI", "cmd": "ng update @angular/cli @angular/core" },
        { "label": "Limpiar caché y reinstalar", "cmd": "npm uninstall -g @angular/cli && npm cache clean --force && npm i -g @angular/cli" },
        { "label": "Crear nueva app", "cmd": "ng new nombre-app" },
        { "label": "Crear app con routing + scss sin tests", "cmd": "ng new nombre-app --routing --style scss --skip-tests" },
        { "label": "Crear componente", "cmd": "ng g c components/header --flat --skip-tests" },
        { "label": "Crear componente standalone", "cmd": "ng g c components/dashboard --standalone --skip-tests" },
        { "label": "Crear servicio", "cmd": "ng g s services/api --skip-tests" },
        { "label": "Crear módulo", "cmd": "ng g m modules/dashboard" },
        { "label": "Crear interface", "cmd": "ng g i models/user" },
        { "label": "Crear pipe", "cmd": "ng generate p nombre --skip-tests" },
        { "label": "Crear guard", "cmd": "ng g guard guards/auth" },
        { "label": "Crear interceptor", "cmd": "ng g interceptor interceptors/http" },
        { "label": "Crear environments", "cmd": "ng g environments" },
        { "label": "Agregar paquete (Angular Fire)", "cmd": "ng add @angular/fire" },
        { "label": "Servir app (abrir navegador)", "cmd": "ng serve -o" },
        { "label": "Servir app en otro puerto", "cmd": "ng serve --port 4401" },
        { "label": "Build producción", "cmd": "ng build --prod" },
        { "label": "Ejecutar tests", "cmd": "ng test" },
        { "label": "Ejecutar lint", "cmd": "ng lint" },
        { "label": "Limpiar caché Angular", "cmd": "ng cache clean" }
      ]
    },
    {
      "id": "nestjs",
      "title": "NestJS",
      "icon": "devicon-nestjs-plain",
      "color": "#e73c68",
      "description": "Framework backend con Node y TypeScript.",
      "link": "https://docs.nestjs.com/",
      "commands": [
        { "label": "Ver versión", "cmd": "nest -v" },
        { "label": "Crear proyecto", "cmd": "nest new nombre-proyecto" },
        { "label": "Iniciar en modo watch", "cmd": "nest start --watch" },
        { "label": "Build", "cmd": "nest build" },
        { "label": "Crear controlador", "cmd": "nest g co nombre --no-spec" },
        { "label": "Crear módulo", "cmd": "nest g mo nombre" },
        { "label": "Crear servicio", "cmd": "nest g s nombre --no-spec" },
        { "label": "Crear recurso CRUD completo", "cmd": "nest g resource nombre" },
        { "label": "Crear guard", "cmd": "nest g gu nombre --no-spec" },
        { "label": "Crear interceptor", "cmd": "nest g interceptor nombre --no-spec" },
        { "label": "Crear middleware", "cmd": "nest g middleware nombre --no-spec" },
        { "label": "Crear filter (exception)", "cmd": "nest g f nombre --no-spec" }
      ]
    },
    {
      "id": "firebase",
      "title": "Firebase & AngularFire",
      "icon": "devicon-firebase-plain",
      "color": "#ff9d00",
      "description": "Backend como servicio de Google.",
      "link": "https://console.firebase.google.com/",
      "commands": [
        { "label": "Instalar Firebase CLI", "cmd": "npm i -g firebase-tools" },
        { "label": "Iniciar sesión", "cmd": "firebase login" },
        { "label": "Ver proyectos", "cmd": "firebase projects:list" },
        { "label": "Inicializar Firebase en proyecto", "cmd": "firebase init" },
        { "label": "Desplegar a Firebase Hosting", "cmd": "firebase deploy --only hosting" },
        { "label": "Desplegar solo funciones", "cmd": "firebase deploy --only functions" },
        { "label": "Emular Firebase local", "cmd": "firebase emulators:start" },
        { "label": "Integrar AngularFire al proyecto", "cmd": "ng add @angular/fire" }
      ]
    },
    {
      "id": "vite",
      "title": "Vite",
      "icon": "devicon-vitejs-plain",
      "color": "#b294bb",
      "description": "Bundler ultrarrápido para proyectos modernos.",
