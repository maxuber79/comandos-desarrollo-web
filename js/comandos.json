        { "label": "Cambiar nombre rama default", "cmd": "git branch -m master main" },
        { "label": "Crear nueva rama", "cmd": "git branch nombre-rama" },
        { "label": "Crear y moverse a nueva rama", "cmd": "git checkout -b nombre-rama" },
        { "label": "Renombrar rama actual", "cmd": "git branch -m nuevo-nombre" },
        { "label": "Renombrar rama (estando en otra)", "cmd": "git branch -m antigua nueva" },
        { "label": "Listar ramas", "cmd": "git branch" },
        { "label": "Ver estado actual", "cmd": "git status" },
        { "label": "Moverse a una rama", "cmd": "git checkout nombre-rama" },
        { "label": "Diferencias entre ramas", "cmd": "git diff nombre-rama main" },
        { "label": "Fusionar rama", "cmd": "git merge nombre-rama" },
        { "label": "Borrar rama local", "cmd": "git branch -d nombre-rama" },
        { "label": "Forzar borrado de rama local", "cmd": "git branch -D nombre-rama" },
        { "label": "Borrar rama remota", "cmd": "git push origin --delete nombre-rama" },
        { "label": "Crear tag (release)", "cmd": "git tag -a v1.0.0 -m \"Release inicial\"" },
        { "label": "Subir tags", "cmd": "git push --tags" },
        { "label": "Generar clave SSH", "cmd": "ssh-keygen -t ed25519 -C \"email@ejemplo.com\"" },
