        { "label": "Eliminar archivo de Git", "cmd": "git rm archivo.txt" },
        { "label": "Reset suave (deshacer commit, mantén cambios)", "cmd": "git reset --soft HEAD~1" },
        { "label": "Reset duro (⚠️ descarta todo)", "cmd": "git reset --hard HEAD~1" },
        { "label": "Crear y cambiar de rama (moderno)", "cmd": "git switch -c nombre-rama" },
        { "label": "Cambiar de rama (moderno)", "cmd": "git switch nombre-rama" },
        { "label": "Volver a la rama anterior", "cmd": "git switch -" },
        { "label": "Descartar cambios locales (moderno)", "cmd": "git restore archivo.ts" },
        { "label": "Descartar todos los cambios", "cmd": "git restore ." },
        { "label": "Force push seguro (recomendado)", "cmd": "git push --force-with-lease origin main" },
        { "label": "Ver registro de referencia (recuperación)", "cmd": "git reflog" },
        { "label": "Ver quién modificó cada línea", "cmd": "git blame archivo.ts" },
        { "label": "Log con diffs completos", "cmd": "git log -p" },
        { "label": "Log de un autor específico", "cmd": "git log --author=\"nombre\"" },
        { "label": "Trabajar en 2 ramas a la vez", "cmd": "git worktree add ../carpeta nombre-rama" },
        { "label": "Listar worktrees", "cmd": "git worktree list" },
        { "label": "Agregar submódulo", "cmd": "git submodule add https://github.com/USER/REPO.git ruta" },
        { "label": "Inicializar submódulos", "cmd": "git submodule update --init --recursive" },
        { "label": "Limpiar archivo untracked", "cmd": "git clean -fd" },
        { "label": "Buscar en el código (grep)", "cmd": "git grep \"texto\"" }
      ]
    },
