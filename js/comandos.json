      "commands": [
        { "label": "Crear proyecto Vite vanilla", "cmd": "npm create vite@latest" },
        { "label": "Crear proyecto con React + TS", "cmd": "npm create vite@latest mi-app -- --template react-ts" },
        { "label": "Levantar servidor dev", "cmd": "npm run dev" },
